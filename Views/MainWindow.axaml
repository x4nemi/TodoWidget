<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TodoApp.ViewModels"
        xmlns:views="using:TodoApp.Views"
        x:Class="TodoApp.Views.MainWindow"
        Title="TodoApp" Width="300" Height="200"
        WindowStartupLocation="CenterScreen"
        FontFamily="Menlo">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.Styles>
        <Style Selector="Button /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.2"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#FF5555"/>
            <Setter Property="Opacity" Value="0.8"/>
        </Style>
    </Window.Styles>

    <ContentControl Content="{Binding CurrentPage}" Margin="20">
        <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:TodoListViewModel">
                <views:TodoListView />
            </DataTemplate>
            <DataTemplate DataType="vm:TodoDetailViewModel">
                <views:TodoDetailView />
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>
</Window>
